# Copy this file to .env and fill in what you have. Never share the .env file.
#
# Which LLMs take part in the study is decided HERE: a model listed in
# config.yaml whose token is missing below is skipped automatically.
# The token NAMES come from `api_key_env` in config.yaml - to add a new LLM,
# add its block there and its token here. No code changes.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=

# Judge / EGDA auditor token (config.yaml -> judges: judge-deepseek).
# The judge model, endpoint and family are set in config.yaml, not here.
JUDGE_API_KEY=

# Hugging Face token - OPTIONAL. morebench/morebench is public; a token
# just raises your rate limit. Create one at
# https://huggingface.co/settings/tokens if you hit rate limits, then run:
# python fetch_morebench.py
HF_TOKEN=
